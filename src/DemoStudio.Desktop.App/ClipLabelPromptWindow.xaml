<Window x:Class="DemoStudio.Desktop.App.ClipLabelPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Next Clip Title"
        Width="460"
        Height="210"
        MinWidth="420"
        MinHeight="190"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F8FF">
    <Border Margin="12"
            Padding="14"
            CornerRadius="8"
            BorderBrush="#C4D8FF"
            BorderThickness="1"
            Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#173C8E"
                       Text="Name the next clip (optional)" />
            <TextBlock Grid.Row="1"
                       Margin="0,8,0,8"
                       Foreground="#4D628F"
                       TextWrapping="Wrap"
                       Text="Add a short title now so timeline segments stay clear while recording." />
            <TextBox x:Name="LabelTextBox"
                     Grid.Row="2"
                     Height="34"
                     VerticalContentAlignment="Center" />
            <StackPanel Grid.Row="3"
                        Margin="0,14,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button MinWidth="92"
                        Margin="0,0,8,0"
                        Content="Skip"
                        Click="Skip_Click" />
                <Button MinWidth="92"
                        Content="Apply"
                        Click="Apply_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
