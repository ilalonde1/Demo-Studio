<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.18.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DemoStudio.Desktop.Core\DemoStudio.Desktop.Core.csproj" />
    <ProjectReference Include="..\DemoStudio.Infrastructure\DemoStudio.Infrastructure.csproj" />
    <ProjectReference Include="..\DemoStudio.Capture.Abstractions\DemoStudio.Capture.Abstractions.csproj" />
    <ProjectReference Include="..\DemoStudio.Domain\DemoStudio.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\DemoStudio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DemoStudio.ico" />
    <Resource Include="Assets\logo-256.png" />
  </ItemGroup>

</Project>
