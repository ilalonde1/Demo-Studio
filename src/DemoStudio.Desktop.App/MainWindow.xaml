<Window x:Class="DemoStudio.Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/DemoStudio.ico"
        Height="760"
        Width="1200"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}">
    <Window.Resources>
        <LinearGradientBrush x:Key="BrushWindowBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EDF2FA" Offset="0" />
            <GradientStop Color="#E7EEF9" Offset="0.52" />
            <GradientStop Color="#DEE7F8" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BrushTextStrong" Color="#122A57" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="#4C628F" />
        <SolidColorBrush x:Key="BrushAccent" Color="#1C4ED8" />
        <SolidColorBrush x:Key="BrushCard" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BrushCardSoft" Color="#F8FAFF" />
        <SolidColorBrush x:Key="BrushBorder" Color="#D9E2F3" />
        <LinearGradientBrush x:Key="BrushHeroBg" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#143884" Offset="0" />
            <GradientStop Color="#1B4EB8" Offset="0.56" />
            <GradientStop Color="#245ED8" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="BrushHeroText" Color="#EEF4FF" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1843B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F4F7FF" />
            <Setter Property="Foreground" Value="#1A3D86" />
            <Setter Property="BorderBrush" Value="#BED0F6" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C43A3A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#9D2B2B" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFF" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="RowHeight" Value="34" />
        </Style>

        <Style x:Key="ChipBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#EDF3FF" />
            <Setter Property="BorderBrush" Value="#C6D8FE" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextStrong}" />
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#4D628F" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Modifiers="Control+Shift" Key="D1" Command="{Binding StartClipCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="D2" Command="{Binding PauseClipCommand}" />
        <KeyBinding Modifiers="Control+Shift" Key="D3" Command="{Binding StopSessionCommand}" />
    </Window.InputBindings>
    <DockPanel LastChildFill="True" Margin="20">
        <Border DockPanel.Dock="Top"
                Margin="0,0,0,14"
                CornerRadius="10"
                Padding="14"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                Background="{StaticResource BrushCard}"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Recording Controls"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsHitTestVisible="False"
                            Focusable="False" />
                    <Button Margin="8,0,0,0"
                            Content="Ctrl+Shift+1 Start/Resume"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsHitTestVisible="False"
                            Focusable="False" />
                    <Button Margin="8,0,0,0"
                            Content="Ctrl+Shift+2 Pause"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsHitTestVisible="False"
                            Focusable="False" />
                    <Button Margin="8,0,0,0"
                            Content="Ctrl+Shift+3 Stop"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsHitTestVisible="False"
                            Focusable="False" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               Foreground="{StaticResource BrushTextMuted}"
                               Text="Next Clip Label" />
                    <TextBox Width="160"
                             Margin="0,0,8,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Optional label applied to the next clip when you start/resume."
                             Text="{Binding Curation.NextClipLabel, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Stop Session"
                            MinWidth="130"
                            ToolTip="Stop current recording session."
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding StopSessionCommand}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top"
                Margin="0,0,0,14"
                CornerRadius="10"
                Padding="14"
                BorderBrush="#C5D7FC"
                BorderThickness="1"
                Background="#EEF4FF"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Visibility="Collapsed">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#173C8E"
                               Text="{Binding Onboarding.StepNumber, StringFormat=Quick Start ({0}/3)}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#173C8E"
                               Text="{Binding Onboarding.Title}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#2D4D93"
                               TextWrapping="Wrap"
                               Text="{Binding Onboarding.Detail}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Back"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding Onboarding.PreviousCommand}" />
                    <Button Margin="8,0,0,0"
                            Content="{Binding Onboarding.NextLabel}"
                            Command="{Binding Onboarding.NextCommand}" />
                    <Button Margin="8,0,0,0"
                            Content="Skip"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding Onboarding.DismissCommand}" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                CornerRadius="12"
                Padding="18"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border CornerRadius="10"
                            Padding="14"
                            Background="{StaticResource BrushHeroBg}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Width="48"
                                        Height="48"
                                        CornerRadius="24"
                                        Background="#F5F9FF"
                                        BorderBrush="#C9DBFF"
                                        BorderThickness="1">
                                    <Image Width="42"
                                           Height="42"
                                           Source="Assets/logo-256.png"
                                           Stretch="Uniform" />
                                </Border>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock FontSize="31"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushHeroText}"
                                               Text="Recorder Studio" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="15"
                                               Foreground="{StaticResource BrushHeroText}"
                                               Opacity="0.92"
                                               Text="Manual capture. You decide when each clip starts and stops." />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,10,0,0"
                                Orientation="Horizontal">
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <TextBlock Foreground="#23447F"
                                       FontWeight="SemiBold"
                                       Text="{Binding StateText, StringFormat=State: {0}}" />
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <TextBlock Foreground="#23447F"
                                       FontWeight="SemiBold"
                                       Text="{Binding ClipCount, StringFormat=Clips: {0}}" />
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}">
                            <TextBlock Foreground="#23447F"
                                       FontWeight="SemiBold"
                                       Text="{Binding DurationText, StringFormat=Duration: {0}}" />
                        </Border>
                    </StackPanel>
                    <Border Margin="0,10,0,0"
                            Padding="10"
                            CornerRadius="8"
                            Background="#F3F7FF"
                            BorderBrush="#C7D8FB"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <Border Padding="8,6"
                                        CornerRadius="6"
                                        Background="{Binding Workflow.Step1Background}"
                                        BorderBrush="#C7D8FB"
                                        BorderThickness="1">
                                    <TextBlock FontWeight="SemiBold" Foreground="{Binding Workflow.Step1TextColor}" Text="1. Choose Target" />
                                </Border>
                                <TextBlock Margin="4,4,0,0" FontSize="12" Foreground="#35528F" Text="Select capture mode and lock the window." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <Border Padding="8,6"
                                        CornerRadius="6"
                                        Background="{Binding Workflow.Step2Background}"
                                        BorderBrush="#C7D8FB"
                                        BorderThickness="1">
                                    <TextBlock FontWeight="SemiBold" Foreground="{Binding Workflow.Step2TextColor}" Text="2. Record Flow" />
                                </Border>
                                <TextBlock Margin="4,4,0,0" FontSize="12" Foreground="#35528F" Text="Start recording, pause to split clips, resume as needed." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <Border Padding="8,6"
                                        CornerRadius="6"
                                        Background="{Binding Workflow.Step3Background}"
                                        BorderBrush="#C7D8FB"
                                        BorderThickness="1">
                                    <TextBlock FontWeight="SemiBold" Foreground="{Binding Workflow.Step3TextColor}" Text="3. Curate Clips" />
                                </Border>
                                <TextBlock Margin="4,4,0,0" FontSize="12" Foreground="#35528F" Text="Open curation, reorder clips, and set banner text." />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <Border Padding="8,6"
                                        CornerRadius="6"
                                        Background="{Binding Workflow.Step4Background}"
                                        BorderBrush="#C7D8FB"
                                        BorderThickness="1">
                                    <TextBlock FontWeight="SemiBold" Foreground="{Binding Workflow.Step4TextColor}" Text="4. Export Video" />
                                </Border>
                                <TextBlock Margin="4,4,0,0" FontSize="12" Foreground="#35528F" Text="Build your final video and export it." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                <Border Grid.Row="1"
                        Margin="0,18,0,0"
                        Padding="14"
                        CornerRadius="8"
                        Background="#EEF4FF"
                        BorderBrush="#BCD1FF"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#173C8E"
                                       Text="{Binding Workflow.WorkflowStepTitle}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="13"
                                       Foreground="#2D4D93"
                                       TextWrapping="Wrap"
                                       Text="{Binding Workflow.WorkflowStepDetail}" />
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="13"
                                       Foreground="#173C8E"
                                       Text="{Binding Workflow.GuidanceText}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="#2D4D93"
                                       Text="Nothing auto-starts. Recording begins only when you click Start Clip." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center">
                            <Button MinWidth="170"
                                    Padding="16,8"
                                    Content="{Binding Workflow.PrimaryWorkflowActionText}"
                                    ToolTip="Primary action for this stage: Start, Pause/Resume, or Stop."
                                    Command="{Binding PrimaryWorkflowCommand}" />
                            <Button Margin="0,8,0,0"
                                    MinWidth="170"
                                    Content="Open Clip Editor"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenCurationCommand}" />
                            <Button Margin="0,8,0,0"
                                    MinWidth="170"
                                    Content="Build Final Video"
                                    Command="{Binding ComposeManifestCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Padding="12"
                        CornerRadius="8"
                        Background="#EEF4FF"
                        BorderBrush="#BCD1FF"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#173C8E"
                                   FontWeight="SemiBold"
                                   Text="Next: adjust clip order, then build and export your final video." />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Foreground="#4D628F"
                                       Text="Quality" />
                            <ComboBox Width="120"
                                      Margin="0,0,8,0"
                                      ItemsSource="{Binding Production.ComposeQualityPresets}"
                                      SelectedItem="{Binding Production.SelectedComposeQualityPreset, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Open Clip Editor"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenCurationCommand}" />
                            <Button Margin="8,0,0,0"
                                    Content="Build Final Video"
                                    Command="{Binding ComposeManifestCommand}" />
                            <Button Margin="8,0,0,0"
                                    Content="Open Output Folder"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding OpenLatestOutputFolderCommand}" />
                            <Button Margin="8,0,0,0"
                                    Content="Publish Package"
                                    Command="{Binding CreatePublishPackageCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TabControl Grid.Row="3" Margin="0,10,0,0">
                    <TabItem Header="Record">
                    <Border
                            CornerRadius="8"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Background="{StaticResource BrushCardSoft}"
                            Padding="16">
                        <StackPanel IsEnabled="{Binding CanEditTargetSettings}">
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="What to Record" />
                            <TextBlock Style="{StaticResource SectionHintStyle}"
                                       Text="Pick what to capture, then use Record Now from the Control Panel." />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" Style="{StaticResource FieldLabelStyle}" Text="Record Type" />
                                <ComboBox Grid.Row="0"
                                          Grid.Column="1"
                                          Grid.ColumnSpan="4"
                                          Margin="0,0,0,10"
                                          MinWidth="180"
                                          ToolTip="Window captures only the selected app window. Desktop captures the full screen."
                                          SelectedValue="{Binding Targeting.CaptureMode, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content">
                                    <ComboBoxItem Content="Window" />
                                    <ComboBoxItem Content="Desktop" />
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" Style="{StaticResource FieldLabelStyle}" Text="Target Window" />
                                <ComboBox Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,0,8,10"
                                         ToolTip="Pick the window to capture."
                                         ItemsSource="{Binding Targeting.WindowCandidates}"
                                         SelectedItem="{Binding Targeting.SelectedWindowCandidate, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,0,8,10"
                                        Content="Refresh"
                                        ToolTip="Refresh currently available windows."
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RefreshWindowsCommand}" />
                                <Button Grid.Row="1"
                                        Grid.Column="3"
                                        Margin="0,0,0,10"
                                        Content="Focus"
                                        ToolTip="Bring the selected target window to the foreground."
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding FocusTargetCommand}" />
                            </Grid>
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="#4D628F"
                                       Text="{Binding Targeting.WindowSelectionStatus}" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="#4D628F"
                                       Text="Tip: Focus target once, then use Control Panel hotkeys while demoing." />
                            <StackPanel Margin="0,10,0,0"
                                        Orientation="Horizontal">
                                <Button Content="Save Session"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Save current session draft so it can be restored after restart."
                                        Command="{Binding SaveSessionDraftCommand}" />
                                <Button Margin="8,0,0,0"
                                        Content="Close Session"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Close current session and clear working clip state."
                                        Command="{Binding CloseSessionCommand}" />
                                <Button Margin="8,0,0,0"
                                        Content="New Session"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="Start a fresh session and clear restored draft data."
                                        Command="{Binding StartNewSessionCommand}" />
                            </StackPanel>
                            <Border Margin="0,10,0,0"
                                    Padding="10"
                                    CornerRadius="8"
                                    Background="#EEF4FF"
                                    BorderBrush="#BCD1FF"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="#173C8E"
                                               FontWeight="SemiBold"
                                               Text="{Binding LastRuntimeMessage}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="#4D628F"
                                                   Text="Control Panel: Ctrl+Shift+1 Start/Resume | Ctrl+Shift+2 Pause | Ctrl+Shift+3 Stop" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Margin="0,10,0,0"
                                    Padding="10"
                                    CornerRadius="8"
                                    Background="#F7FAFF"
                                    BorderBrush="#D1E0FF"
                                    BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   FontWeight="SemiBold"
                                                   Foreground="#173C8E"
                                                   Text="Live Clip Timeline" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Foreground="#4D628F"
                                                   Text="{Binding ClipCount, StringFormat={}{0} clip(s)}" />
                                    </DockPanel>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="#4D628F"
                                               Text="Clips appear here as you record. Pause/Resume creates a new segment." />
                                    <ScrollViewer Margin="0,8,0,0"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding Curation.CurrentSessionClips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="{Binding TimelineWidth}"
                                                            MinWidth="120"
                                                            Margin="0,0,8,0"
                                                            CornerRadius="8"
                                                            Padding="10,8"
                                                            BorderBrush="#BCD1FF"
                                                            BorderThickness="1"
                                                            Background="#EEF4FF"
                                                            ToolTip="Double-click to preview this clip."
                                                            MouseLeftButtonDown="TimelineCard_OnMouseLeftButtonDown">
                                                        <StackPanel>
                                                            <Border Height="54"
                                                                    CornerRadius="5"
                                                                    BorderBrush="#C8D8FA"
                                                                    BorderThickness="1"
                                                                    Background="#E3ECFF">
                                                                <Image Source="{Binding ThumbnailImage}"
                                                                       Stretch="UniformToFill" />
                                                            </Border>
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Margin="0,6,0,0"
                                                                       Foreground="#173C8E"
                                                                       Text="{Binding Order, StringFormat=Segment {0}}" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       Foreground="#2D4D93"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding Label}" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="12"
                                                                       Foreground="#4D628F"
                                                                       Text="{Binding DurationDisplay}" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       Foreground="#3B5FA6"
                                                                       Text="{Binding NarrationStatus, StringFormat=Voice: {0}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Expander Margin="0,12,0,0"
                                      Header="More Options (troubleshooting)"
                                      IsExpanded="False">
                                <StackPanel Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Check Setup"
                                                ToolTip="Validate FFmpeg, storage, and target matching."
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding RunPreflightCommand}" />
                                    </StackPanel>
                                    <Border Margin="0,10,0,0"
                                            Padding="10"
                                            CornerRadius="8"
                                            Background="#EEF4FF"
                                            BorderBrush="#BCD1FF"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="#173C8E"
                                                       Text="Setup Check Details" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="#274B8E"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Targeting.PreflightStatus}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="#4D628F"
                                                       Text="{Binding Targeting.ReadinessLastChecked}" />
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#4D628F" Text="Window title contains" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Targeting.WindowTitleContains, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <CheckBox Margin="0,10,0,0"
                                              IsChecked="{Binding Targeting.FallbackToDesktop, UpdateSourceTrigger=PropertyChanged}"
                                              Content="If target is not found, capture desktop instead" />

                                    <CheckBox Margin="0,8,0,0"
                                              IsChecked="{Binding Production.CaptureNarration, UpdateSourceTrigger=PropertyChanged}"
                                              Content="Record microphone narration" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#4D628F"
                                                   Text="Microphone device" />
                                         <TextBox Grid.Column="1"
                                                 ToolTip="Optional: leave blank to use default microphone."
                                                 Text="{Binding MicrophoneDeviceName, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <CheckBox Margin="0,8,0,0"
                                              IsChecked="{Binding Production.PresenterViewEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              Content="Presenter View (controls on monitor 1, target on monitor 2)" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#4D628F"
                                                   Text="Presenter notes" />
                                        <TextBox Grid.Column="1"
                                                 ToolTip="Notes shown in Control Panel only."
                                                 Text="{Binding Production.PresenterNotes, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>

                                    <Expander Margin="0,10,0,0"
                                              Header="Window Matching (advanced)"
                                              IsExpanded="False">
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Foreground="#4D628F" Text="Process name" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Targeting.WindowProcessName, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#4D628F" Text="Window handle" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Targeting.WindowHandleHex, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Expander>

                                    <TextBlock Margin="0,4,0,0" Foreground="#4D628F" Text="Optional App Launch" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#4D628F" Text="Saved Launch" />
                                        <ComboBox Grid.Column="1"
                                                  Margin="0,0,8,0"
                                                  ToolTip="Optional: choose a saved launch profile."
                                                  ItemsSource="{Binding Targeting.LaunchProfiles}"
                                                  SelectedItem="{Binding Targeting.SelectedLaunchProfile, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name" />
                                        <Button Grid.Column="2"
                                                Margin="0,0,8,0"
                                                Content="Load"
                                                ToolTip="Load selected launch profile values into editor fields."
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding LoadLaunchProfileCommand}" />
                                        <Button Grid.Column="3"
                                                Content="Launch"
                                                ToolTip="Launch target app using current launch profile."
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding LaunchTargetCommand}" />
                                    </Grid>

                                    <TextBlock Margin="0,10,0,0" Foreground="#4D628F" Text="Demo Template" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#4D628F"
                                                   Text="Template Name" />
                                        <TextBox Grid.Column="1"
                                                 Margin="0,0,8,0"
                                                 Text="{Binding Production.TemplateName, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2"
                                                Margin="0,0,8,0"
                                                Content="Save"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding SaveDemoTemplateCommand}" />
                                        <Button Grid.Column="3"
                                                Margin="0,0,8,0"
                                                Content="Apply"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ApplyDemoTemplateCommand}" />
                                        <Button Grid.Column="4"
                                                Content="Delete"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DeleteDemoTemplateCommand}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#4D628F"
                                                   Text="Saved Templates" />
                                        <ComboBox Grid.Column="1"
                                                  Margin="0,0,8,0"
                                                  ItemsSource="{Binding Production.DemoTemplates}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Name"
                                                  SelectedValue="{Binding Production.SelectedTemplateName, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="2"
                                                Content="Refresh"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding RefreshDemoTemplatesCommand}" />
                                    </Grid>

                                    <Expander Margin="0,12,0,0"
                                              Header="App Launch Manager (advanced)"
                                              IsExpanded="False">
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Foreground="#4D628F"
                                                       Text="Create or edit reusable launch profiles." />
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Foreground="#4D628F" Text="Profile Name" />
                                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Targeting.LaunchProfileName, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Foreground="#4D628F" Text="Executable Path" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Targeting.LaunchExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Foreground="#4D628F" Text="Arguments" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Targeting.LaunchArguments, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" Foreground="#4D628F" Text="Working Directory" />
                                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Text="{Binding Targeting.LaunchWorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#4D628F" Text="Startup Delay (s)" />
                                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Targeting.LaunchStartupDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Margin="0,0,8,0" Content="Save Profile" ToolTip="Save or update this launch profile." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SaveLaunchProfileCommand}" />
                                                <Button Margin="0,0,8,0" Content="Delete Profile" ToolTip="Delete selected launch profile." Style="{StaticResource DangerButtonStyle}" Command="{Binding DeleteLaunchProfileCommand}" />
                                                <Button Content="Refresh Profiles" ToolTip="Reload saved launch profiles from disk." Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshLaunchProfilesCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <TextBlock Margin="0,12,0,0" Foreground="#4D628F" Text="Capture Storage Location:" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#152D65" TextWrapping="Wrap" Text="{Binding StorageRoot}" />
                                    <TextBlock Margin="0,10,0,0" Foreground="#4D628F" Text="Most Recent Output:" />
                                    <TextBlock Margin="0,4,0,0" Foreground="#152D65" TextWrapping="Wrap" Text="{Binding SessionState.LastOutputPath}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    </TabItem>
                    <TabItem Header="Edit + Export">
                    <Border
                            CornerRadius="8"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            Background="{StaticResource BrushCardSoft}"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Current Session" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,8" Text="Session" Foreground="#4B5E8A" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding SessionId}" Foreground="#152D65" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,8" Text="State" Foreground="#4B5E8A" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding StateText}" Foreground="#152D65" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,8" Text="Clip Count" Foreground="#4B5E8A" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ClipCount}" Foreground="#152D65" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,0" Text="Duration" Foreground="#4B5E8A" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DurationText}" Foreground="#152D65" />
                            </Grid>
                            <TextBlock Margin="0,16,0,0"
                                       Foreground="#4B5E8A"
                                       Text="Runtime" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="#152D65"
                                       TextWrapping="Wrap"
                                       Text="{Binding LastRuntimeMessage}" />
                            <Border Margin="0,10,0,0"
                                    Padding="10"
                                    CornerRadius="8"
                                    Background="#EEF4FF"
                                    BorderBrush="#BCD1FF"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="#173C8E"
                                               Text="Performance" />
                                    <Border Margin="0,6,0,0"
                                            Padding="8,6"
                                            CornerRadius="8"
                                            Background="{Binding PerformanceHealthBackground}"
                                            BorderBrush="{Binding PerformanceHealthBorder}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="#173C8E"
                                                       Text="{Binding PerformanceHealthLabel, StringFormat=Budget: {0}}" />
                                                <TextBlock Margin="10,0,0,0"
                                                           Foreground="#35528F"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding PerformanceHealthDetail}" />
                                            </StackPanel>
                                    </Border>
                                    <Border Margin="0,6,0,0"
                                            Padding="8,6"
                                            CornerRadius="8"
                                            Background="{Binding DependencyHealthBackground}"
                                            BorderBrush="{Binding DependencyHealthBorder}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="#173C8E"
                                                       Text="{Binding DependencyHealthLabel}" />
                                            <TextBlock Margin="10,0,0,0"
                                                       Foreground="#35528F"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding DependencyHealthDetail}" />
                                        </StackPanel>
                                    </Border>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Border Style="{StaticResource ChipBorderStyle}">
                                            <TextBlock Foreground="#23447F" FontWeight="SemiBold" Text="{Binding MemoryWorkingSetText}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipBorderStyle}">
                                            <TextBlock Foreground="#23447F" FontWeight="SemiBold" Text="{Binding MemoryPrivateText}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipBorderStyle}">
                                            <TextBlock Foreground="#23447F" FontWeight="SemiBold" Text="{Binding CaptureWriteRateText}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipBorderStyle}">
                                            <TextBlock Foreground="#23447F" FontWeight="SemiBold" Text="{Binding CaptureFileSizeText}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipBorderStyle}">
                                            <TextBlock Foreground="#23447F" FontWeight="SemiBold" Text="{Binding ComposeLastRunText}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="#4D628F"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Text="{Binding PerformanceSummary}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,12,0,0"
                                        Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Foreground="#4D628F"
                                           Text="Quality" />
                                <ComboBox Width="120"
                                          Margin="0,0,8,0"
                                          ItemsSource="{Binding Production.ComposeQualityPresets}"
                                          SelectedItem="{Binding Production.SelectedComposeQualityPreset, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock VerticalAlignment="Center"
                                           Margin="0,0,6,0"
                                           Foreground="#4D628F"
                                           Text="Style" />
                                <ComboBox Width="140"
                                          Margin="0,0,8,0"
                                          ItemsSource="{Binding Production.ExportStylePresets}"
                                          SelectedItem="{Binding Production.SelectedExportStyle, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Open Clip Editor"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding OpenCurationCommand}" />
                                    <Button Margin="8,0,0,0"
                                            Content="Start New Session"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding StartNewSessionCommand}" />
                                    <Button Margin="8,0,0,0"
                                            Content="Build Final Video"
                                            Command="{Binding ComposeManifestCommand}" />
                                <Button Margin="8,0,0,0"
                                        Content="Publish Package"
                                        Command="{Binding CreatePublishPackageCommand}" />
                            </StackPanel>
                            <Expander Margin="0,14,0,0"
                                      Header="Clip Editor"
                                      IsExpanded="{Binding Curation.IsClipCurationExpanded, Mode=TwoWay}">
                                <StackPanel Margin="0,8,0,0">
                                        <TextBlock Foreground="#4D628F"
                                               FontSize="12"
                                               Text="Timeline (drag segments to reorder):" />
                                    <ListBox x:Name="ClipTimelineList"
                                             Margin="0,6,0,8"
                                             Height="150"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemsSource="{Binding Curation.CurrentSessionClips}"
                                             SelectedItem="{Binding Curation.SelectedCurrentSessionClip, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewMouseLeftButtonDown="ClipTimelineList_OnPreviewMouseLeftButtonDown"
                                             PreviewMouseLeftButtonUp="ClipTimelineList_OnPreviewMouseLeftButtonUp"
                                             PreviewMouseMove="ClipTimelineList_OnPreviewMouseMove"
                                             PreviewDragOver="ClipTimelineList_OnPreviewDragOver"
                                             Drop="ClipTimelineList_OnDrop"
                                             AllowDrop="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Margin" Value="0,0,8,0" />
                                                <Setter Property="Padding" Value="0" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding TimelineWidth}"
                                                        CornerRadius="8"
                                                        Padding="10,8"
                                                        BorderBrush="#BCD1FF"
                                                        BorderThickness="1"
                                                        Background="#EEF4FF"
                                                        ToolTip="Double-click to preview this clip."
                                                        MouseLeftButtonDown="TimelineCard_OnMouseLeftButtonDown">
                                                    <StackPanel>
                                                        <Border Height="54"
                                                                CornerRadius="5"
                                                                BorderBrush="#C8D8FA"
                                                                BorderThickness="1"
                                                                Background="#E3ECFF">
                                                            <Image Source="{Binding ThumbnailImage}"
                                                                   Stretch="UniformToFill" />
                                                        </Border>
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Margin="0,6,0,0"
                                                                   Foreground="#173C8E"
                                                                   Text="{Binding Order, StringFormat=Segment {0}}" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Foreground="#2D4D93"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Label}" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="12"
                                                                   Foreground="#4D628F"
                                                                   Text="{Binding DurationDisplay}" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="#3B5FA6"
                                                                   Text="{Binding NarrationStatus, StringFormat=Voice: {0}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <DataGrid Height="160"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="False"
                                              CanUserAddRows="False"
                                              AllowDrop="True"
                                              PreviewMouseLeftButtonDown="ClipGrid_OnPreviewMouseLeftButtonDown"
                                              PreviewMouseLeftButtonUp="ClipGrid_OnPreviewMouseLeftButtonUp"
                                              PreviewMouseMove="ClipGrid_OnPreviewMouseMove"
                                              PreviewDragOver="ClipGrid_OnPreviewDragOver"
                                              Drop="ClipGrid_OnDrop"
                                              EnableRowVirtualization="True"
                                              EnableColumnVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ItemsSource="{Binding Curation.CurrentSessionClips}"
                                              SelectedItem="{Binding Curation.SelectedCurrentSessionClip, UpdateSourceTrigger=PropertyChanged}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Order" Binding="{Binding Order}" Width="55" IsReadOnly="True" />
                                            <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="40" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="180" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Banner Text" Binding="{Binding BannerText, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                            <DataGridTextColumn Header="Voice Script" Binding="{Binding NarrationScript, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                                            <DataGridCheckBoxColumn Header="Narration" Binding="{Binding IncludeNarration, UpdateSourceTrigger=PropertyChanged}" Width="95" />
                                            <DataGridTextColumn Header="Voiceover" Binding="{Binding NarrationStatus}" Width="95" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="90" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Margin="0,0,8,0"
                                                Content="Move Up"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding MoveClipUpCommand}" />
                                        <Button Content="Move Down"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding MoveClipDownCommand}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   Margin="10,0,6,0"
                                                   Foreground="#4D628F"
                                                   Text="Quality" />
                                        <ComboBox Width="120"
                                                  Margin="0,0,8,0"
                                                  ItemsSource="{Binding Production.ComposeQualityPresets}"
                                                  SelectedItem="{Binding Production.SelectedComposeQualityPreset, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox Width="140"
                                                  Margin="0,0,8,0"
                                                  ItemsSource="{Binding Production.ExportStylePresets}"
                                                  SelectedItem="{Binding Production.SelectedExportStyle, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Margin="8,0,0,0"
                                                Content="Build Final Video"
                                                Command="{Binding ComposeManifestCommand}" />
                                        <Button Margin="8,0,0,0"
                                                Content="Publish Package"
                                                Command="{Binding CreatePublishPackageCommand}" />
                                        <Button Margin="8,0,0,0"
                                                Content="Record Narration"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding RecordNarrationCommand}" />
                                        <Button Margin="8,0,0,0"
                                                Content="Generate AI Narration"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding GenerateAiNarrationCommand}" />
                                        <Button Margin="8,0,0,0"
                                                Content="Play Narration"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding PlayNarrationCommand}" />
                                        <Button Margin="8,0,0,0"
                                                Content="Clear Narration"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding ClearNarrationCommand}" />
                                    </StackPanel>
                                    <Expander Margin="0,8,0,0"
                                              Header="AI Voice Settings"
                                              IsExpanded="False">
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Margin="0,0,8,8"
                                                       VerticalAlignment="Center"
                                                       Foreground="#4D628F"
                                                       Text="Provider" />
                                            <TextBox Grid.Row="0"
                                                     Grid.Column="1"
                                                     Margin="0,0,12,8"
                                                     Text="{Binding Production.AiNarrationProvider, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="2"
                                                       Margin="0,0,8,8"
                                                       VerticalAlignment="Center"
                                                       Foreground="#4D628F"
                                                       Text="Voice" />
                                            <TextBox Grid.Row="0"
                                                     Grid.Column="3"
                                                     Margin="0,0,12,8"
                                                     Text="{Binding Production.AiNarrationVoice, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="0"
                                                       Margin="0,0,8,8"
                                                       VerticalAlignment="Center"
                                                       Foreground="#4D628F"
                                                       Text="Model" />
                                            <TextBox Grid.Row="1"
                                                     Grid.Column="1"
                                                     Margin="0,0,12,8"
                                                     Text="{Binding Production.AiNarrationModel, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="2"
                                                       Margin="0,0,8,8"
                                                       VerticalAlignment="Center"
                                                       Foreground="#4D628F"
                                                       Text="Words / sec" />
                                            <TextBox Grid.Row="1"
                                                     Grid.Column="3"
                                                     Margin="0,0,12,8"
                                                     Text="{Binding AiWordsPerSecond, UpdateSourceTrigger=PropertyChanged, StringFormat=0.0}" />

                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="0"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#4D628F"
                                                       Text="Base URL" />
                                            <TextBox Grid.Row="2"
                                                     Grid.Column="1"
                                                     Margin="0,0,12,0"
                                                     Text="{Binding Production.AiNarrationBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="2"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="#4D628F"
                                                       Text="API Key (optional override)" />
                                            <TextBox Grid.Row="2"
                                                     Grid.Column="3"
                                                     Margin="0,0,12,0"
                                                     Text="{Binding Production.AiNarrationApiKey, UpdateSourceTrigger=PropertyChanged}" />

                                            <CheckBox Grid.Row="0"
                                                      Grid.Column="4"
                                                      Margin="8,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding AiAutoTrimScript, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="Auto-trim script to clip duration" />
                                        </Grid>
                                    </Expander>
                                    <TextBlock Margin="0,6,0,0"
                                               Foreground="#4D628F"
                                               Text="{Binding Production.ComposeStatus}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="#4D628F"
                                               Text="{Binding Production.PublishStatus}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Copy Share Summary"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding CopyShareSummaryCommand}" />
                                        <Button Margin="8,0,0,0"
                                                Content="Open Compose Health"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding OpenComposeHealthCommand}" />
                                        <Button Margin="8,0,0,0"
                                                Content="Open Publish Zip"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding OpenPublishZipCommand}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="#5870A2"
                                               FontSize="12"
                                               Text="{Binding Production.ShareSummary}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="#5870A2"
                                               FontSize="12"
                                               Text="Tip: Select clip rows to reorder and set optional banner text before compose." />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
        <Expander Grid.Row="1"
                  Margin="0,14,0,0"
                  Header="Session History"
                  IsExpanded="False">
        <Border CornerRadius="10"
                Padding="16"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                Background="{StaticResource BrushCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextStrong}"
                               Text="Session History" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#6A7FA8"
                               FontSize="12"
                               Text="Latest sessions appear first. Select a row to enable folder open/delete actions." />
                </StackPanel>
                <DataGrid Grid.Row="1"
                          Margin="0,10,0,10"
                          MinHeight="180"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ItemsSource="{Binding History.Records}"
                          SelectedItem="{Binding History.SelectedRecord, UpdateSourceTrigger=PropertyChanged}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                        <DataGridTextColumn Header="Completed (UTC)" Binding="{Binding CompletedUtc}" Width="170" />
                        <DataGridTextColumn Header="Clips" Binding="{Binding ClipCount}" Width="70" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="90" />
                        <DataGridTextColumn Header="Size" Binding="{Binding FileSizeDisplay}" Width="95" />
                        <DataGridTextColumn Header="Failure Code" Binding="{Binding FailureCodeDisplay}" Width="140" />
                        <DataGridTextColumn Header="Failure Reason" Binding="{Binding FailureReason}" Width="220" />
                        <DataGridTextColumn Header="Fix Hint" Binding="{Binding FixHintDisplay}" Width="260" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="#4D628F"
                               Text="{Binding History.Status}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Content="Run Recorder Check"
                                ToolTip="Runs a quick recorder check and reports readiness."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RunSmokeCheckCommand}" />
                        <Button Margin="0,0,8,0"
                                Content="Refresh"
                                ToolTip="Refresh session history from disk."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshHistoryCommand}" />
                        <Button Margin="0,0,8,0"
                                Content="Open Folder"
                                ToolTip="Open selected session output folder."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenSessionFolderCommand}" />
                        <Button Margin="0,0,8,0"
                                Content="Copy Fix Hint"
                                ToolTip="Copy suggested fix for selected failure."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CopyFixHintCommand}" />
                        <Button Content="Delete"
                                ToolTip="Delete selected session and associated artifacts."
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteSessionCommand}" />
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="3"
                           Margin="0,8,0,0"
                           VerticalAlignment="Center"
                           Foreground="#4D628F"
                           Text="{Binding SmokeCheckStatus}" />
            </Grid>
        </Border>
        </Expander>
    </Grid>
    </ScrollViewer>
    </DockPanel>
</Window>




