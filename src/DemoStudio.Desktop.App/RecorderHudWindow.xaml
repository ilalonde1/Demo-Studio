<Window x:Class="DemoStudio.Desktop.App.RecorderHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recorder Control Panel"
        Width="920"
        Height="204"
        MinWidth="860"
        MaxWidth="1120"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="ToolWindow"
        Background="#F4F8FF">
    <Window.Resources>
        <Style x:Key="HudPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1C4ED8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1C4ED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="HudDangerButton" TargetType="Button" BasedOn="{StaticResource HudPrimaryButton}">
            <Setter Property="Background" Value="#C93D3D" />
            <Setter Property="BorderBrush" Value="#C93D3D" />
        </Style>
        <Style x:Key="HotkeyTagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border Margin="8"
            Padding="10"
            CornerRadius="8"
            BorderBrush="#C4D8FF"
            BorderThickness="1"
            Background="#FFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="8" Padding="8,3" Background="#EDF3FF" BorderBrush="#C6D8FE" BorderThickness="1" Margin="0,0,8,0">
                    <TextBlock Text="{Binding StateText, StringFormat=State: {0}}" FontWeight="SemiBold" Foreground="#23447F" />
                </Border>
                <Border CornerRadius="8" Padding="8,3" Background="#EDF3FF" BorderBrush="#C6D8FE" BorderThickness="1" Margin="0,0,8,0">
                    <TextBlock Text="{Binding ClipCount, StringFormat=Clips: {0}}" FontWeight="SemiBold" Foreground="#23447F" />
                </Border>
                <Border CornerRadius="8" Padding="8,3" Background="#EDF3FF" BorderBrush="#C6D8FE" BorderThickness="1">
                    <TextBlock Text="{Binding DurationText, StringFormat=Duration: {0}}" FontWeight="SemiBold" Foreground="#23447F" />
                </Border>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel VerticalAlignment="Center">
                    <Border Margin="0,0,8,0"
                            Padding="0"
                            CornerRadius="12"
                            Background="#F2F7FF"
                            BorderBrush="#C6D8FE"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E5EEFF" Padding="8,4" CornerRadius="12,0,0,12">
                                <TextBlock Style="{StaticResource HotkeyTagText}" Foreground="#2B4D8A" Text="Hotkey" />
                            </Border>
                            <Border Background="#F2F7FF" Padding="8,4">
                                <TextBlock Style="{StaticResource HotkeyTagText}" Foreground="#1F3D74" Text="Ctrl+Shift+1" />
                            </Border>
                            <Border Background="#EDF8F1" Padding="8,4" CornerRadius="0,12,12,0">
                                <TextBlock Style="{StaticResource HotkeyTagText}" Foreground="#1F6A49" Text="Start/Resume" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0"
                            Padding="0"
                            CornerRadius="12"
                            Background="#F2F7FF"
                            BorderBrush="#C6D8FE"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E5EEFF" Padding="8,4" CornerRadius="12,0,0,12">
                                <TextBlock Style="{StaticResource HotkeyTagText}" Foreground="#2B4D8A" Text="Hotkey" />
                            </Border>
                            <Border Background="#F2F7FF" Padding="8,4">
                                <TextBlock Style="{StaticResource HotkeyTagText}" Foreground="#1F3D74" Text="Ctrl+Shift+2" />
                            </Border>
                            <Border Background="#FFF5E8" Padding="8,4" CornerRadius="0,12,12,0">
                                <TextBlock Style="{StaticResource HotkeyTagText}" Foreground="#8A5A18" Text="Pause" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Padding="0"
                            CornerRadius="12"
                            Background="#F2F7FF"
                            BorderBrush="#C6D8FE"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E5EEFF" Padding="8,4" CornerRadius="12,0,0,12">
                                <TextBlock Style="{StaticResource HotkeyTagText}" Foreground="#2B4D8A" Text="Hotkey" />
                            </Border>
                            <Border Background="#F2F7FF" Padding="8,4">
                                <TextBlock Style="{StaticResource HotkeyTagText}" Foreground="#1F3D74" Text="Ctrl+Shift+3" />
                            </Border>
                            <Border Background="#FFEDEE" Padding="8,4" CornerRadius="0,12,12,0">
                                <TextBlock Style="{StaticResource HotkeyTagText}" Foreground="#9A3038" Text="Stop" />
                            </Border>
                        </StackPanel>
                    </Border>
                </WrapPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource HudPrimaryButton}"
                        Margin="10,0,8,0"
                        MinWidth="128"
                        Content="{Binding PrimaryWorkflowActionText}"
                        Command="{Binding PrimaryWorkflowCommand}" />
                <Button Grid.Column="2"
                        Style="{StaticResource HudDangerButton}"
                        MinWidth="104"
                        Content="Stop"
                        Command="{Binding StopSessionCommand}" />
            </Grid>
            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    Padding="8,6"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="#C6D8FE"
                    Background="#F6FAFF">
                <TextBlock Text="{Binding PresenterNotes, StringFormat=Notes: {0}}"
                           Foreground="#35528F"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</Window>
