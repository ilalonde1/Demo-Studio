<Window x:Class="DemoStudio.Desktop.App.RecorderHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recorder HUD"
        Width="340"
        Height="110"
        MinWidth="340"
        MinHeight="110"
        MaxWidth="560"
        MaxHeight="220"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="ToolWindow"
        Background="#DDF4F8FF"
        Opacity="0.97">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="HudButtonBase" TargetType="Button">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="HudPrimaryButton" TargetType="Button" BasedOn="{StaticResource HudButtonBase}">
            <Setter Property="Background" Value="#1C4ED8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1C4ED8" />
        </Style>
        <Style x:Key="HudSecondaryButton" TargetType="Button" BasedOn="{StaticResource HudButtonBase}">
            <Setter Property="Background" Value="#F4F8FF" />
            <Setter Property="Foreground" Value="#23447F" />
            <Setter Property="BorderBrush" Value="#C6D8FE" />
        </Style>
        <Style x:Key="HudDangerButton" TargetType="Button" BasedOn="{StaticResource HudButtonBase}">
            <Setter Property="Background" Value="#C93D3D" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#C93D3D" />
        </Style>
        <Style x:Key="HotkeyTagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border Margin="6"
            Padding="10"
            CornerRadius="10"
            BorderBrush="#BFD5FF"
            BorderThickness="1"
            Background="#F7FBFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="StepCapturedIndicator"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-4,0,0"
                    Padding="8,4"
                    CornerRadius="999"
                    BorderBrush="#B8E0C5"
                    BorderThickness="1"
                    Background="#ECFAF1"
                    Opacity="0"
                    Visibility="Collapsed"
                    Panel.ZIndex="5">
                <TextBlock x:Name="StepCapturedIndicatorText"
                           Foreground="#216A43"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="Step captured" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#173C8E"
                               Text="Recorder HUD" />
                    <Border Margin="8,0,0,0"
                            Padding="8,2"
                            CornerRadius="999"
                            Background="#EDF3FF"
                            BorderBrush="#C6D8FE"
                            BorderThickness="1">
                        <TextBlock Text="{Binding StateText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#23447F" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding ToggleModeButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource HudSecondaryButton}"
                        Margin="6,0,0,0"
                        Command="{Binding ToggleCompactModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,10,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#173C8E"
                               Text="{Binding DurationText}" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="#4D628F"
                               FontSize="12"
                               Text="{Binding ClipCount, StringFormat=Clip count: {0}}" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Stop"
                            Style="{StaticResource HudDangerButton}"
                            MinWidth="86"
                            Command="{Binding StopSessionCommand}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,10,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="8"
                            Padding="8,3"
                            Background="#EDF3FF"
                            BorderBrush="#C6D8FE"
                            BorderThickness="1"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding ClipCount, StringFormat=Clips: {0}}"
                                   FontWeight="SemiBold"
                                   Foreground="#23447F" />
                    </Border>
                    <Border CornerRadius="8"
                            Padding="8,3"
                            Background="#EDF3FF"
                            BorderBrush="#C6D8FE"
                            BorderThickness="1">
                        <TextBlock Text="{Binding DurationText, StringFormat=Duration: {0}}"
                                   FontWeight="SemiBold"
                                   Foreground="#23447F" />
                    </Border>
                </StackPanel>

                <WrapPanel Grid.Row="1"
                           Margin="0,10,0,0">
                    <Button Content="{Binding HudRecordActionText}"
                            Visibility="{Binding CanStartClip, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource HudPrimaryButton}"
                            MinWidth="86"
                            Command="{Binding StartClipCommand}" />
                    <Button Content="Pause"
                            Visibility="{Binding CanPauseClip, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource HudSecondaryButton}"
                            MinWidth="86"
                            Command="{Binding PauseClipCommand}" />
                    <Button Content="Stop"
                            Visibility="{Binding CanStopSession, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource HudDangerButton}"
                            MinWidth="86"
                            Command="{Binding StopSessionCommand}" />
                    <Button Content="Add Step Marker"
                            Visibility="{Binding CanAddMarker, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource HudSecondaryButton}"
                            MinWidth="118"
                            Command="{Binding AddMarkerCommand}" />
                </WrapPanel>

                <WrapPanel Grid.Row="2"
                           Margin="0,10,0,0"
                           VerticalAlignment="Center">
                    <Border Margin="0,0,8,0"
                            Padding="0"
                            CornerRadius="12"
                            Background="#F2F7FF"
                            BorderBrush="#C6D8FE"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E5EEFF"
                                    Padding="8,4"
                                    CornerRadius="12,0,0,12">
                                <TextBlock Style="{StaticResource HotkeyTagText}"
                                           Foreground="#2B4D8A"
                                           Text="Ctrl+Shift+1" />
                            </Border>
                            <Border Background="#EDF8F1"
                                    Padding="8,4"
                                    CornerRadius="0,12,12,0">
                                <TextBlock Style="{StaticResource HotkeyTagText}"
                                           Foreground="#1F6A49"
                                           Text="Record" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0"
                            Padding="0"
                            CornerRadius="12"
                            Background="#F2F7FF"
                            BorderBrush="#C6D8FE"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E5EEFF"
                                    Padding="8,4"
                                    CornerRadius="12,0,0,12">
                                <TextBlock Style="{StaticResource HotkeyTagText}"
                                           Foreground="#2B4D8A"
                                           Text="Ctrl+Shift+2" />
                            </Border>
                            <Border Background="#FFF5E8"
                                    Padding="8,4"
                                    CornerRadius="0,12,12,0">
                                <TextBlock Style="{StaticResource HotkeyTagText}"
                                           Foreground="#8A5A18"
                                           Text="Pause" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Padding="0"
                            CornerRadius="12"
                            Background="#F2F7FF"
                            BorderBrush="#C6D8FE"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#E5EEFF"
                                    Padding="8,4"
                                    CornerRadius="12,0,0,12">
                                <TextBlock Style="{StaticResource HotkeyTagText}"
                                           Foreground="#2B4D8A"
                                           Text="Ctrl+Shift+3" />
                            </Border>
                            <Border Background="#FFEDEE"
                                    Padding="8,4"
                                    CornerRadius="0,12,12,0">
                                <TextBlock Style="{StaticResource HotkeyTagText}"
                                           Foreground="#9A3038"
                                           Text="Stop" />
                            </Border>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Grid.Row="3"
                        Margin="0,10,0,0"
                        Padding="8,6"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="#C6D8FE"
                        Background="#F6FAFF">
                    <TextBlock Text="{Binding PresenterNotes, StringFormat=Notes: {0}}"
                               Foreground="#35528F"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
