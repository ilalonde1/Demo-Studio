<Window x:Class="DemoStudio.Desktop.App.StageWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DemoStudio Stage Workspace"
        Width="1366"
        Height="820"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FF">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="8"
                BorderBrush="#C8D6F6"
                BorderThickness="1"
                Background="White"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="AddressTextBox"
                         Grid.Column="0"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Text="https://www.bing.com"
                         KeyDown="AddressTextBox_OnKeyDown" />
                <Button Grid.Column="1"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Content="Go"
                        Click="GoButton_OnClick" />
                <Button Grid.Column="2"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Content="Back"
                        Click="BackButton_OnClick" />
                <Button Grid.Column="3"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Content="Forward"
                        Click="ForwardButton_OnClick" />
                <Button Grid.Column="4"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Content="Refresh"
                        Click="RefreshButton_OnClick" />
                <Button Grid.Column="5"
                        Padding="10,6"
                        Content="Open External"
                        Click="OpenExternalButton_OnClick" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                CornerRadius="8"
                BorderBrush="#C8D6F6"
                BorderThickness="1"
                Background="White">
            <wv2:WebView2 x:Name="Browser" />
        </Border>
    </Grid>
</Window>
